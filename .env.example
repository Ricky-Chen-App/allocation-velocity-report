# Jira Cloud connection — copy to .env and fill in real values
JIRA_DOMAIN=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=your_jira_api_token_here
PORT=3000

# Supabase — backs the manually-curated AirPay Wins & Blockers panels.
# Use the SERVICE ROLE key, not the anon/publishable key: both tables have RLS
# enabled with no policies, so only the service role can read or write them.
# Never expose this key to the browser — all access goes through /api/*.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
